# ---------------------------------------------------------------------------
# Core Configuration
# ---------------------------------------------------------------------------
# Required: Google Spreadsheet ID (from URL: /spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Required: Path to Service Account JSON Key (~, ${HOME}, relative, or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# ---------------------------------------------------------------------------
# Spot Gold Target Cells (Enclose in single quotes if sheet tab has spaces)
# ---------------------------------------------------------------------------
CELL_GOLD_VALUE='Gold Rates'!B2
CELL_GOLD_CHANGE='Gold Rates'!C2
CELL_GOLD_CHANGE_PCT='Gold Rates'!D2

# ---------------------------------------------------------------------------
# Generic NSE Symbol 1 Configuration
# ---------------------------------------------------------------------------
NSE_SYMBOL_1=SGBJUL28IV
CELL_NSE_SYMBOL_1_NAME='Gold Rates'!B5
CELL_NSE_SYMBOL_1_PRICE='Gold Rates'!C5

# ---------------------------------------------------------------------------
# Generic NSE Symbol 2 Configuration
# ---------------------------------------------------------------------------
NSE_SYMBOL_2=SGBFEB32IV
CELL_NSE_SYMBOL_2_NAME='Gold Rates'!B6
CELL_NSE_SYMBOL_2_PRICE='Gold Rates'!C6
